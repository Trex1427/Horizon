rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() > 0;
    }

    function incomingOwnerUid() {
      return request.resource.data.ownerUid;
    }

    function existingOwnerUid() {
      return resource.data.ownerUid;
    }

    function createsOwnDocument() {
      return isSignedIn()
        && incomingOwnerUid() is string
        && incomingOwnerUid() == request.auth.uid;
    }

    function readsOwnDocument() {
      return isSignedIn()
        && existingOwnerUid() is string
        && existingOwnerUid() == request.auth.uid;
    }

    function updatesOwnDocument() {
      return readsOwnDocument()
        && incomingOwnerUid() is string
        && incomingOwnerUid() == existingOwnerUid();
    }

    function deletesOwnDocument() {
      return readsOwnDocument();
    }

    function parentPath(debtReceivableId) {
      return /databases/$(database)/documents/debtsReceivables/$(debtReceivableId);
    }

    function paymentPath(paymentId) {
      return /databases/$(database)/documents/debtReceivablePayments/$(paymentId);
    }

    function transactionPath(transactionId) {
      return /databases/$(database)/documents/transactions/$(transactionId);
    }

    function accountPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId);
    }

    function inferredPaymentsRevision(data) {
      return data.keys().hasAny(["paymentsRevision"])
        ? data.paymentsRevision
        : 0;
    }

    function hasNoPersistedCalculatedDebtFields(data) {
      return !data.keys().hasAny(["paidAmount", "remainingAmount", "status"]);
    }

    function doesNotChangePersistedCalculatedDebtFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paidAmount", "remainingAmount", "status"]);
    }

    function hasValidInitialPaymentMarkers() {
      return request.resource.data.keys().hasAny(["paymentsRevision"])
        && request.resource.data.paymentsRevision is int
        && request.resource.data.paymentsRevision == 0
        && !request.resource.data.keys().hasAny(["paymentsMutationId"]);
    }

    function hasValidPaymentsRevisionShape(data) {
      return !data.keys().hasAny(["paymentsRevision"])
        || (data.paymentsRevision is int && data.paymentsRevision >= 0);
    }

    function finalParentIsOwnedAndActive(debtReceivableId) {
      return existsAfter(parentPath(debtReceivableId))
        && getAfter(parentPath(debtReceivableId)).data.ownerUid == request.auth.uid
        && getAfter(parentPath(debtReceivableId)).data.isDeleted != true;
    }

    function hasValidDateYyyyMmDd(value) {
      return value is string
        && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function hasValidPaymentSchema(data) {
      return data.keys().hasOnly([
          "ownerUid",
          "debtReceivableId",
          "amount",
          "paymentDate",
          "createdAt",
          "updatedAt",
          "isDeleted",
          "note",
          "accountId",
          "label",
          "transactionId",
          "deletedAt",
        ])
        && data.keys().hasAll([
          "ownerUid",
          "debtReceivableId",
          "amount",
          "paymentDate",
          "createdAt",
          "updatedAt",
          "isDeleted",
        ])
        && data.ownerUid is string
        && data.ownerUid.size() > 0
        && data.debtReceivableId is string
        && data.debtReceivableId.size() > 0
        && data.amount is number
        && data.amount > 0
        && hasValidDateYyyyMmDd(data.paymentDate)
        && (data.createdAt is timestamp || data.createdAt == null)
        && (data.updatedAt is timestamp || data.updatedAt == null)
        && data.isDeleted is bool
        && (!data.keys().hasAny(["note"]) || data.note is string || data.note == null)
        && (!data.keys().hasAny(["accountId"]) || data.accountId is string)
        && (!data.keys().hasAny(["label"]) || data.label is string)
        && (!data.keys().hasAny(["transactionId"]) || data.transactionId is string || data.transactionId == null)
        && (!data.keys().hasAny(["deletedAt"]) || data.deletedAt is timestamp);
    }

    function isInitialDebtReceivableTransaction(data) {
      return data.keys().hasAny(["debtReceivableInitial"])
        && data.debtReceivableInitial == true
        && data.debtReceivableId is string;
    }

    function hasReciprocalInitialDebtReceivableTransaction(transactionId) {
      return isInitialDebtReceivableTransaction(request.resource.data)
        && existsAfter(parentPath(request.resource.data.debtReceivableId))
        && getAfter(parentPath(request.resource.data.debtReceivableId)).data.ownerUid == request.auth.uid
        && getAfter(parentPath(request.resource.data.debtReceivableId)).data.initialTransactionId == transactionId
        && request.resource.data.type == "depense"
        && request.resource.data.montant == getAfter(parentPath(request.resource.data.debtReceivableId)).data.amount
        && request.resource.data.date == getAfter(parentPath(request.resource.data.debtReceivableId)).data.initialDate
        && request.resource.data.accountId == getAfter(parentPath(request.resource.data.debtReceivableId)).data.initialAccountId
        && request.resource.data.categoryId == getAfter(parentPath(request.resource.data.debtReceivableId)).data.initialCategoryId
        && request.resource.data.thirdPartyId == getAfter(parentPath(request.resource.data.debtReceivableId)).data.thirdPartyId
        && request.resource.data.isDeleted == getAfter(parentPath(request.resource.data.debtReceivableId)).data.isDeleted
        && request.resource.data.updatedAt == request.time
        && getAfter(parentPath(request.resource.data.debtReceivableId)).data.updatedAt == request.time;
    }
    function isLinkedTransaction(data) {
      return data.keys().hasAny(["debtReceivablePaymentId"])
        && data.debtReceivablePaymentId is string
        && data.debtReceivablePaymentId.size() > 0;
    }

    function hasReciprocalLinkedPayment(transactionId) {
      return isLinkedTransaction(request.resource.data)
        && existsAfter(paymentPath(request.resource.data.debtReceivablePaymentId))
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.ownerUid == request.auth.uid
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.transactionId == transactionId
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.debtReceivableId == request.resource.data.debtReceivableId
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.amount == request.resource.data.montant
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.paymentDate == request.resource.data.date
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.accountId == request.resource.data.accountId
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.isDeleted == request.resource.data.isDeleted
        && getAfter(paymentPath(request.resource.data.debtReceivablePaymentId)).data.updatedAt == request.time
        && existsAfter(parentPath(request.resource.data.debtReceivableId))
        && request.resource.data.type == (getAfter(parentPath(request.resource.data.debtReceivableId)).data.type == "receivable" ? "revenu" : "depense")
        && exists(accountPath(request.resource.data.accountId))
        && get(accountPath(request.resource.data.accountId)).data.ownerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidLinkedTransaction(transactionId, paymentId, debtReceivableId, shouldBeDeleted) {
      return transactionId is string
        && transactionId.size() > 0
        && existsAfter(transactionPath(transactionId))
        && getAfter(transactionPath(transactionId)).data.ownerUid == request.auth.uid
        && getAfter(transactionPath(transactionId)).data.debtReceivablePaymentId == paymentId
        && getAfter(transactionPath(transactionId)).data.debtReceivableId == debtReceivableId
        && getAfter(transactionPath(transactionId)).data.accountId is string
        && getAfter(transactionPath(transactionId)).data.accountId.size() > 0
        && exists(accountPath(getAfter(transactionPath(transactionId)).data.accountId))
        && get(accountPath(getAfter(transactionPath(transactionId)).data.accountId)).data.ownerUid == request.auth.uid
        && getAfter(transactionPath(transactionId)).data.type in ["depense", "revenu"]
        && getAfter(transactionPath(transactionId)).data.date is string
        && getAfter(transactionPath(transactionId)).data.montant is number
        && getAfter(transactionPath(transactionId)).data.montant is number
        && getAfter(transactionPath(transactionId)).data.montant > 0
        && getAfter(transactionPath(transactionId)).data.isDeleted == shouldBeDeleted
        && getAfter(transactionPath(transactionId)).data.updatedAt == request.time;
    }
    function canDeletePaymentWithoutLinkedTransaction(transactionId) {
      return request.resource.data.isDeleted == true
        && (
          !(transactionId is string)
          || transactionId.size() == 0
          || !existsAfter(transactionPath(transactionId))
        );
    }
    function hasReciprocalParentMutation(debtReceivableId, paymentId) {
      return exists(parentPath(debtReceivableId))
        && existsAfter(parentPath(debtReceivableId))
        && get(parentPath(debtReceivableId)).data.ownerUid == request.auth.uid
        && get(parentPath(debtReceivableId)).data.isDeleted != true
        && finalParentIsOwnedAndActive(debtReceivableId)
        && (
          (
            !get(parentPath(debtReceivableId)).data.keys().hasAny(["updatedAt"])
            && !getAfter(parentPath(debtReceivableId)).data.keys().hasAny(["updatedAt"])
          )
          ||
          (
            get(parentPath(debtReceivableId)).data.keys().hasAny(["updatedAt"])
            && getAfter(parentPath(debtReceivableId)).data.keys().hasAny(["updatedAt"])
            && getAfter(parentPath(debtReceivableId)).data.updatedAt == get(parentPath(debtReceivableId)).data.updatedAt
          )
        )
        && getAfter(parentPath(debtReceivableId)).data.diff(get(parentPath(debtReceivableId)).data).affectedKeys().hasOnly(["paymentsRevision", "paymentsMutationId"])
        && getAfter(parentPath(debtReceivableId)).data.paymentsMutationId == paymentId
        && inferredPaymentsRevision(getAfter(parentPath(debtReceivableId)).data) is int
        && inferredPaymentsRevision(get(parentPath(debtReceivableId)).data) is int
        && inferredPaymentsRevision(getAfter(parentPath(debtReceivableId)).data) == inferredPaymentsRevision(get(parentPath(debtReceivableId)).data) + 1
        && !getAfter(parentPath(debtReceivableId)).data.diff(get(parentPath(debtReceivableId)).data).affectedKeys().hasAny(["paidAmount", "remainingAmount", "status"]);
    }

    function hasReciprocalPaymentWrite(debtReceivableId, paymentId) {
      return paymentId is string
        && paymentId.size() > 0
        && existsAfter(paymentPath(paymentId))
        && getAfter(paymentPath(paymentId)).data.ownerUid == request.auth.uid
        && getAfter(paymentPath(paymentId)).data.debtReceivableId == debtReceivableId
        && getAfter(paymentPath(paymentId)).data.updatedAt == request.time;
    }

    function isValidPaymentCoupledParentUpdate(debtReceivableId) {
      return doesNotChangePersistedCalculatedDebtFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paymentsRevision", "paymentsMutationId"])
        && (
          (
            !resource.data.keys().hasAny(["updatedAt"])
            && !request.resource.data.keys().hasAny(["updatedAt"])
          )
          ||
          (
            resource.data.keys().hasAny(["updatedAt"])
            && request.resource.data.keys().hasAny(["updatedAt"])
            && request.resource.data.updatedAt == resource.data.updatedAt
          )
        )
        && request.resource.data.paymentsMutationId is string
        && request.resource.data.paymentsMutationId.size() > 0
        && hasValidPaymentsRevisionShape(request.resource.data)
        && hasReciprocalPaymentWrite(debtReceivableId, request.resource.data.paymentsMutationId)
        && inferredPaymentsRevision(request.resource.data) == inferredPaymentsRevision(resource.data) + 1;
    }

    function isOrdinaryDebtReceivableUpdate() {
      return doesNotChangePersistedCalculatedDebtFields()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentsRevision", "paymentsMutationId"])
        && hasValidPaymentsRevisionShape(request.resource.data);
    }

    match /accounts/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }


    function hasValidWorkProjectLink(data) {
      return !data.keys().hasAny(["workProjectId"])
        || data.workProjectId == null
        || (
          data.workProjectId is string
          && data.workProjectId.size() > 0
          && exists(/databases/$(database)/documents/workProjects/$(data.workProjectId))
          && get(/databases/$(database)/documents/workProjects/$(data.workProjectId)).data.ownerUid == request.auth.uid
        );
    }

    match /transactions/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument()
        && hasValidWorkProjectLink(request.resource.data)
        && (
          (!isLinkedTransaction(request.resource.data) && !isInitialDebtReceivableTransaction(request.resource.data))
          || hasReciprocalLinkedPayment(documentId)
          || hasReciprocalInitialDebtReceivableTransaction(documentId)
        );
      allow update: if updatesOwnDocument()
        && hasValidWorkProjectLink(request.resource.data)
        && (
          (!isLinkedTransaction(resource.data) && !isLinkedTransaction(request.resource.data)
            && !isInitialDebtReceivableTransaction(resource.data) && !isInitialDebtReceivableTransaction(request.resource.data))
          || (isLinkedTransaction(resource.data)
            && request.resource.data.debtReceivablePaymentId == resource.data.debtReceivablePaymentId
            && hasReciprocalLinkedPayment(documentId))
          || (isInitialDebtReceivableTransaction(resource.data)
            && request.resource.data.debtReceivableId == resource.data.debtReceivableId
            && hasReciprocalInitialDebtReceivableTransaction(documentId))
        );
      allow delete: if deletesOwnDocument() && !isLinkedTransaction(resource.data) && !isInitialDebtReceivableTransaction(resource.data);
    }

    match /categories/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /subcategories/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /thirdParties/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /activities/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /projects/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /budgets/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /goals/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /objectives/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /fixedExpenses/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /recurringIncome/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /bankImports/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /receiptDrafts/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /transactionDrafts/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /opportunities/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /transfers/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if deletesOwnDocument();
    }

    match /debtsReceivables/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument()
        && hasNoPersistedCalculatedDebtFields(request.resource.data)
        && hasValidInitialPaymentMarkers();
      allow update: if updatesOwnDocument()
        && (isOrdinaryDebtReceivableUpdate() || isValidPaymentCoupledParentUpdate(documentId));
      allow delete: if deletesOwnDocument();
    }

    match /debtReceivablePayments/{paymentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument()
        && hasValidPaymentSchema(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isDeleted == false
        && !request.resource.data.keys().hasAny(["deletedAt"])
        && getAfter(paymentPath(paymentId)).data.createdAt == request.time
        && getAfter(paymentPath(paymentId)).data.updatedAt == request.time
        && finalParentIsOwnedAndActive(request.resource.data.debtReceivableId)
        && hasValidLinkedTransaction(request.resource.data.transactionId, paymentId, request.resource.data.debtReceivableId, false)
        && hasReciprocalParentMutation(request.resource.data.debtReceivableId, paymentId);
      allow update: if readsOwnDocument()
        && hasValidPaymentSchema(request.resource.data)
        && resource.data.isDeleted != true
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.debtReceivableId == resource.data.debtReceivableId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.isDeleted == false
            && !request.resource.data.keys().hasAny(["deletedAt"])
          )
          ||
          (
            request.resource.data.isDeleted == true
            && resource.data.isDeleted == false
            && request.resource.data.deletedAt == request.time
            && request.resource.data.amount == resource.data.amount
            && request.resource.data.paymentDate == resource.data.paymentDate
            && request.resource.data.note == resource.data.note
          )
        )
        && (
          hasValidLinkedTransaction(
            request.resource.data.transactionId,
            paymentId,
            request.resource.data.debtReceivableId,
            request.resource.data.isDeleted
          )
          || canDeletePaymentWithoutLinkedTransaction(request.resource.data.transactionId)
        )
        && hasReciprocalParentMutation(request.resource.data.debtReceivableId, paymentId);
      allow delete: if false;
    }

    function hasValidWorkProjectSchema(data) {
      return data.keys().hasOnly([
          "ownerUid", "quoteId", "professionalActivityId", "thirdPartyId", "name",
          "status", "plannedRevenue", "plannedExpenses", "plannedMargin",
          "startDate", "endDate", "description", "notes", "createdAt", "updatedAt", "deletedAt"
        ])
        && data.ownerUid == request.auth.uid
        && data.quoteId is string
        && data.professionalActivityId is string
        && data.thirdPartyId is string
        && data.name is string
        && data.status in ["planned", "in_progress", "on_hold", "completed", "cancelled"]
        && data.plannedRevenue is number
        && data.plannedExpenses is number
        && data.plannedMargin is number
        && data.plannedExpenses >= 0
        && data.plannedMargin == data.plannedRevenue - data.plannedExpenses
        && (!data.keys().hasAny(["description"]) || data.description is string)
        && (!data.keys().hasAny(["notes"]) || data.notes is string);
    }

    function hasValidWorkProjectReferences(documentId, data) {
      return data.quoteId == documentId
        && existsAfter(/databases/$(database)/documents/workQuotes/$(data.quoteId))
        && getAfter(/databases/$(database)/documents/workQuotes/$(data.quoteId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/workQuotes/$(data.quoteId)).data.status == "accepted"
        && getAfter(/databases/$(database)/documents/workQuotes/$(data.quoteId)).data.projectId == documentId
        && exists(/databases/$(database)/documents/professionalActivities/$(data.professionalActivityId))
        && get(/databases/$(database)/documents/professionalActivities/$(data.professionalActivityId)).data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/thirdParties/$(data.thirdPartyId))
        && get(/databases/$(database)/documents/thirdParties/$(data.thirdPartyId)).data.ownerUid == request.auth.uid;
    }

    match /workProjects/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument()
        && hasValidWorkProjectSchema(request.resource.data)
        && hasValidWorkProjectReferences(documentId, request.resource.data)
        && request.resource.data.status == "planned"
        && request.resource.data.plannedExpenses == 0
        && request.resource.data.plannedMargin == request.resource.data.plannedRevenue
        && request.resource.data.startDate == null
        && request.resource.data.endDate == null
        && request.resource.data.deletedAt == null;
      allow update: if updatesOwnDocument()
        && hasValidWorkProjectSchema(request.resource.data)
        && hasValidWorkProjectReferences(documentId, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "status", "plannedExpenses", "plannedMargin", "startDate", "endDate", "description", "notes", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.quoteId == resource.data.quoteId
        && request.resource.data.thirdPartyId == resource.data.thirdPartyId
        && request.resource.data.professionalActivityId == resource.data.professionalActivityId
        && request.resource.data.plannedRevenue == resource.data.plannedRevenue
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /professionalActivities/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if false;
    }

    match /workQuotes/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow get, list: if readsOwnDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
