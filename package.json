{
  "name": "budget-alexandre",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "emulators:start": "firebase emulators:start --only firestore",
    "seed:test": "firebase emulators:exec --only firestore \"node scripts/seed-test-emulator-data.mjs\"",
    "cleanup:test": "firebase emulators:exec --only firestore \"node scripts/cleanup-test-emulator-data.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/integration/firestore-rules-emulator.mjs\"",
    "test:integration": "firebase emulators:exec --only firestore \"node scripts/integration/firestore-emulator-write-cycle.mjs\"",
    "test:cash-adjustment": "firebase emulators:exec --only firestore \"node scripts/integration/cash-balance-adjustment-emulator.mjs\"",
    "test:accounts-emulator": "firebase emulators:exec --only firestore \"node scripts/integration/default-accounts-idempotency-emulator.mjs\"",
    "test:opportunity-realized": "firebase emulators:exec --only firestore \"node scripts/integration/opportunity-realized-transaction-emulator.mjs\"",
    "test:local-read": "firebase emulators:exec --only firestore \"node scripts/integration/seed-and-local-read-check.mjs\"",
    "test:guard-refusal": "node scripts/integration/verify-guard-refusal.mjs",
    "test:remote-untouched": "node scripts/integration/verify-remote-untouched.mjs",
    "test:e2e": "firebase emulators:exec --only firestore \"node scripts/e2e/playwright-write-safety-check.mjs\"",
    "seed:references": "node scripts/seed-reference-data.mjs",
    "cleanup:references": "node scripts/cleanup-reference-data.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "cleanup:demo": "node scripts/cleanup-demo-data.mjs",
    "backup:firestore": "node scripts/backup-firestore.mjs",
    "audit:owneruid:migration": "node scripts/migrations/migrate-owner-uid.mjs --dry-run --project-id=budget-alexandre --database-id=(default)",
    "migrate:owneruid:dry-run": "node scripts/migrations/migrate-owner-uid.mjs --dry-run --project-id=budget-alexandre --database-id=(default)",
    "migrate:owneruid:emulator": "node scripts/migrations/create-owner-uid-emulator-fixture.mjs && firebase emulators:exec --only firestore \"node scripts/migrations/migrate-owner-uid.mjs --apply --seed-fixture --owner-uid=ownerUidFixture123 --project-id=budget-alexandre --database-id=(default) --fixture-path=tmp/owner-uid-emulator-backup --report-name=owner-uid-migration-emulator.json --markdown-name=OWNER_UID_MIGRATION_EMULATOR.md --batch-size=100\"",
    "rollback:owneruid:emulator": "node scripts/migrations/create-owner-uid-emulator-fixture.mjs && firebase emulators:exec --only firestore \"node scripts/migrations/validate-owner-uid-rollback-emulator.mjs\"",
    "fixed-expenses:dedupe:dry-run": "node scripts/maintenance/merge-duplicate-fixed-expenses.mjs --dry-run",
    "inventory:ux-test-data": "node scripts/maintenance/cleanup-ux-test-references.mjs --report-tag=manual",
    "cleanup:ux-test-data": "node scripts/maintenance/cleanup-ux-test-references.mjs --apply --confirm-run --report-tag=manual",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "firebase": "^12.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-admin": "^14.1.0",
    "globals": "^17.6.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
